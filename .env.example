# HTTP token for /.netlify/functions/imap-auth-check (keep separate from IMAP credentials).
IMAP_AUTH_CHECK_TOKEN=replace-with-a-long-random-token

# IMAP credentials stored only in Netlify environment variables.
IMAP_USERNAME=mailbox@example.com
IMAP_PASSWORD=replace-me

# These defaults match Plus IT / SkyMail and can be overridden for testing.
IMAP_HOST=imap.skymail.net.br
IMAP_PORT=993
